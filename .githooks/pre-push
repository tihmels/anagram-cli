#!/bin/sh
# Refuse to push as the wrong GitHub account.
#
# A GITHUB_TOKEN / GH_TOKEN in the environment overrides gh's stored accounts, including the
# credential helper that git uses for https pushes. That silently resolves this repository to
# whichever account minted the env token rather than the account configured in gh, so a push can
# land under the wrong identity without any visible warning.
#
# Install with:  git config core.hooksPath .githooks

set -e

EXPECTED_OWNER="tihmels"
REMOTE_NAME="${1:-origin}"

fail() {
    echo "pre-push: $1" >&2
    echo "" >&2
    echo "  Re-run the push with the environment token suppressed:" >&2
    echo "    env -u GITHUB_TOKEN -u GH_TOKEN git push ${REMOTE_NAME}" >&2
    exit 1
}

if [ -n "${GITHUB_TOKEN:-}" ] || [ -n "${GH_TOKEN:-}" ]; then
    fail "GITHUB_TOKEN/GH_TOKEN is set and would override the gh account for this push."
fi

# The remote must belong to the expected owner, whatever the remote is named.
remote_url=$(git config --get "remote.${REMOTE_NAME}.url" || true)
case "$remote_url" in
    *"github.com/${EXPECTED_OWNER}/"* | *"github.com:${EXPECTED_OWNER}/"*) ;;
    "") ;;  # no such remote configured; leave it to git to complain
    *) fail "remote '$remote_url' is not owned by ${EXPECTED_OWNER}." ;;
esac

# Confirm the identity gh would actually authenticate as, when gh is available.
if command -v gh >/dev/null 2>&1; then
    actual=$(gh api user --jq .login 2>/dev/null || true)
    if [ -n "$actual" ] && [ "$actual" != "$EXPECTED_OWNER" ]; then
        fail "gh resolves to '$actual', expected '${EXPECTED_OWNER}'."
    fi
fi

exit 0
